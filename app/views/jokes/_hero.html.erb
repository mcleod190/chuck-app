<!-- Hero & Randomizer Section -->
<section class="relative overflow-hidden pt-12 pb-16 lg:pt-20 lg:pb-24 border-b border-slate-800/80">
  <div class="absolute inset-0 bg-radial-gradient pointer-events-none"></div>
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs font-black uppercase tracking-widest mb-4">
        <i class="fa-solid fa-bolt"></i> 100% Certified Indestructible Lore
      </div>
      <h1 class="font-bebas text-5xl sm:text-7xl lg:text-8xl tracking-wider text-white leading-none mb-4">
        CHUCK NORRIS <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-amber-500 to-red-500">CANNOT BE BEATEN</span>
      </h1>
      <p class="text-slate-300 text-base sm:text-lg max-w-2xl mx-auto leading-relaxed">
        The definitive collection of legendary Chuck Norris facts, iconic movie meme scenes, and daily personal blessings to supercharge your day.
      </p>
    </div>

    <!-- Interactive Roundhouse Randomizer Card -->
    <div class="max-w-4xl mx-auto bg-slate-900/90 border-2 border-amber-500/50 rounded-3xl p-6 sm:p-8 shadow-2xl relative overflow-hidden" id="random-card-wrapper">
      <div class="flex flex-col md:flex-row gap-6 items-center">
        <!-- Scene Image / Visual -->
        <div class="w-full md:w-5/12 aspect-video md:aspect-[4/3] rounded-2xl overflow-hidden bg-slate-950 border border-slate-800 flex-shrink-0">
          <img id="random-img" 
               src="<%= asset_path("scenes/#{@joke_of_the_day.image_url}") %>" 
               alt="<%= @joke_of_the_day.movie_title %>"
               class="w-full h-full object-cover transition-all duration-300">
        </div>

        <!-- Joke text & controls -->
        <div class="w-full md:w-7/12 flex flex-col justify-between space-y-4">
          <div>
            <div class="flex items-center gap-2 mb-2">
              <span id="random-category" class="text-[10px] font-black uppercase tracking-wider px-2.5 py-1 rounded-full bg-amber-500/20 text-amber-300 border border-amber-500/40">
                <%= @joke_of_the_day.category %>
              </span>
              <span id="random-movie" class="text-xs font-bold text-slate-400">
                🎬 <%= @joke_of_the_day.movie_title %>
              </span>
            </div>

            <h3 id="random-content" class="text-xl sm:text-2xl font-black text-white leading-snug">
              "<%= @joke_of_the_day.content %>"
            </h3>

            <p id="random-scene" class="text-xs text-slate-400 italic mt-3 border-l-2 border-amber-500/40 pl-3">
              <%= @joke_of_the_day.scene_description %>
            </p>
          </div>

          <div class="pt-4 border-t border-slate-800 flex flex-wrap items-center gap-3">
            <button type="button" 
                    id="btn-spin-random"
                    onclick="spinRandomJoke()" 
                    class="bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 px-5 py-2.5 rounded-xl font-black uppercase tracking-wider text-xs shadow-lg shadow-amber-500/20 hover:shadow-amber-500/40 transition-all flex items-center gap-2">
              <i class="fa-solid fa-rotate text-sm" id="spin-icon"></i>
              <span>Roundhouse Another Joke</span>
            </button>

            <button type="button" 
                    id="random-like-btn"
                    onclick="likeJoke(currentRandomId)" 
                    class="flex items-center gap-2 px-4 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 text-xs font-bold transition-all">
              <i class="fa-solid fa-hand-fist text-amber-500"></i>
              <span>Respect</span>
              <span id="random-likes-count" class="font-mono text-amber-400">
                <%= @joke_of_the_day.likes_count %>
              </span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
