<!-- Subscription Section -->
<section id="subscribe" class="py-16 relative overflow-hidden bg-slate-950">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-gradient-to-br from-slate-900 via-slate-900 to-amber-950/40 border-2 border-amber-500 rounded-3xl p-8 sm:p-12 shadow-2xl relative">
      <div class="text-center max-w-2xl mx-auto mb-8">
        <div class="relative w-20 h-20 mx-auto mb-4">
          <div class="w-20 h-20 rounded-full overflow-hidden border-2 border-amber-500 shadow-xl shadow-amber-500/20">
            <%= image_tag "chuck/chuck_portrait.jpg", alt: "Chuck Norris", class: "w-full h-full object-cover object-top" %>
          </div>
          <div class="absolute -bottom-1 -right-1 w-7 h-7 rounded-full bg-amber-500 text-slate-950 flex items-center justify-center text-xs font-black shadow">
            <i class="fa-solid fa-envelope"></i>
          </div>
        </div>
        <h2 class="font-bebas text-4xl sm:text-5xl tracking-wider text-white mb-2">
          JOIN CHUCK'S DAILY BLESSINGS
        </h2>

        <p class="text-slate-300 text-sm sm:text-base">
          Receive today's sharpest Chuck Norris joke, an authentic personal blessing, and a fearless wish for a victorious day delivered directly to your inbox every morning.
        </p>
      </div>

      <!-- Perks grid -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8 text-center sm:text-left">
        <div class="bg-slate-950/60 border border-slate-800 rounded-xl p-3 flex items-center gap-3">
          <i class="fa-solid fa-fire text-amber-500 text-lg flex-shrink-0"></i>
          <span class="text-xs font-semibold text-slate-300">Daily Joke of the Day</span>
        </div>
        <div class="bg-slate-950/60 border border-slate-800 rounded-xl p-3 flex items-center gap-3">
          <i class="fa-solid fa-hands-praying text-red-500 text-lg flex-shrink-0"></i>
          <span class="text-xs font-semibold text-slate-300">Personal Blessing & Good Day Wish</span>
        </div>
        <div class="bg-slate-950/60 border border-slate-800 rounded-xl p-3 flex items-center gap-3">
          <i class="fa-solid fa-shield-halved text-emerald-500 text-lg flex-shrink-0"></i>
          <span class="text-xs font-semibold text-slate-300">Zero Spam (Spam fears Chuck)</span>
        </div>
      </div>

      <!-- Form -->
      <%= form_with model: @subscriber, url: subscribers_path, class: "space-y-4" do |f| %>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <%= f.label :name, "Your Name or Warrior Title (optional)", class: "block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1" %>
            <%= f.text_field :name, placeholder: "e.g. Cordell, Sarah, Lone Wolf", class: "w-full bg-slate-950 border border-slate-700 rounded-xl px-4 py-3 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-amber-500" %>
          </div>
          <div>
            <%= f.label :email, "Your Email Address (required)", class: "block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1" %>
            <%= f.email_field :email, required: true, placeholder: "you@example.com", class: "w-full bg-slate-950 border border-slate-700 rounded-xl px-4 py-3 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-amber-500" %>
          </div>
        </div>

        <div>
          <%= f.label :blessing_tone, "Preferred Blessing Tone from Chuck", class: "block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1" %>
          <%= f.select :blessing_tone, options_for_select(@tones, "Mighty Texas Ranger"), {}, class: "w-full bg-slate-950 border border-slate-700 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-amber-500" %>
        </div>

        <div class="pt-2">
          <%= f.button type: :submit, class: "w-full bg-gradient-to-r from-amber-500 via-amber-400 to-amber-500 hover:from-amber-400 hover:to-amber-300 text-slate-950 py-4 px-6 rounded-xl font-black uppercase tracking-wider text-sm shadow-xl shadow-amber-500/20 hover:shadow-amber-500/40 transition-all flex items-center justify-center gap-2 group cursor-pointer" do %>
            <i class="fa-solid fa-hand-fist group-hover:scale-125 transition-transform"></i>
            <span>Enlist for Daily Blessings & Jokes</span>
          <% end %>
        </div>
      <% end %>

      <div class="mt-6 text-center flex flex-col sm:flex-row items-center justify-center gap-4 text-xs text-slate-400">
        <span>Instant welcome blessing delivered right upon signing up.</span>
        <span class="hidden sm:inline">•</span>
        <a href="<%= preview_email_subscribers_path %>" target="_blank" class="text-amber-400 hover:underline flex items-center gap-1 font-bold">
          <i class="fa-solid fa-eye"></i> Preview Sample Email
        </a>
      </div>
    </div>
  </div>
</section>
