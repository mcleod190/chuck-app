<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background-color: #0b0f19; color: #f8fafc; margin: 0; padding: 20px; }
    .container { max-width: 600px; margin: 0 auto; background: #1a2234; border-radius: 16px; overflow: hidden; border: 2px solid #f59e0b; box-shadow: 0 10px 30px rgba(0,0,0,0.6); }
    .header { background: linear-gradient(135deg, #991b1b, #b45309, #d97706); padding: 30px 20px; text-align: center; }
    .header h1 { margin: 0; color: #ffffff; font-size: 26px; text-transform: uppercase; letter-spacing: 2px; }
    .header p { margin: 8px 0 0; color: #fef3c7; font-size: 14px; font-weight: bold; }
    .content { padding: 30px 25px; line-height: 1.6; }
    .blessing-box { background: #0b0f19; border-left: 4px solid #f59e0b; padding: 20px; border-radius: 8px; margin: 20px 0; font-size: 17px; color: #f1f5f9; }
    .blessing-sig { margin-top: 10px; font-weight: bold; color: #fbbf24; text-align: right; }
    .joke-box { background: #26334d; border: 1px solid #d97706; padding: 22px; border-radius: 12px; margin: 25px 0; }
    .badge { display: inline-block; background: #f59e0b; color: #111827; font-size: 11px; font-weight: 800; text-transform: uppercase; padding: 4px 10px; border-radius: 20px; margin-bottom: 12px; }
    .joke-text { font-size: 20px; font-weight: 700; color: #ffffff; margin: 0 0 12px; line-height: 1.4; }
    .scene-box { background: #111827; padding: 14px; border-radius: 8px; font-size: 13px; color: #94a3b8; margin-top: 10px; }
    .action-btn { display: inline-block; background: #f59e0b; color: #111827; font-weight: bold; text-decoration: none; padding: 12px 28px; border-radius: 8px; text-transform: uppercase; font-size: 14px; letter-spacing: 1px; }
    .footer { text-align: center; padding: 20px; font-size: 12px; color: #64748b; border-top: 1px solid #334155; }
    .footer a { color: #94a3b8; text-decoration: underline; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>CHUCK NORRIS DAILY ROUNDHOUSE</h1>
      <p>Today's Unstoppable Joke & Personal Blessing</p>
    </div>

    <div class="content">
      <p style="font-size: 18px; color: #fde68a;"><strong>Attention, <%= @subscriber.display_name %>!</strong></p>
      
      <p style="color: #cbd5e1;">Your daily dose of power, wisdom, and good day wishes from Chuck Norris has arrived:</p>

      <div class="blessing-box">
        "<%= @blessing %>"
        <div class="blessing-sig">— Chuck Norris</div>
      </div>

      <% if @joke %>
        <div class="joke-box">
          <div class="badge">💥 Joke of the Day</div>
          <div class="joke-text">"<%= @joke.content %>"</div>
          <% if @joke.movie_title.present? %>
            <div class="scene-box">
              🎬 <strong>Movie Lore:</strong> <%= @joke.movie_title %>
              <% if @joke.character_name.present? %>
                (Starring as <em><%= @joke.character_name %></em>)
              <% end %>
              <% if @joke.scene_description.present? %>
                <br>🍿 <em><%= @joke.scene_description %></em>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>

      <div style="text-align: center; margin: 30px 0 10px;">
        <a href="<%= root_url %>" class="action-btn">More Jokes & Meme Scenes</a>
      </div>
    </div>

    <div class="footer">
      <p>Have an unbeatable day. Chuck is counting on you.</p>
      <p><a href="<%= @unsubscribe_url %>">Unsubscribe</a></p>
    </div>
  </div>
</body>
</html>
