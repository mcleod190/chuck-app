<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <title>Chuck Norris Daily Roundhouse — Jokes, Movie Memes & Daily Blessings</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              chuck: {
                gold: '#f59e0b',
                red: '#dc2626',
                dark: '#0a0f1d'
              }
            },
            fontFamily: {
              impact: ['"Bebas Neue"', 'Impact', 'sans-serif'],
              sans: ['Inter', 'system-ui', 'sans-serif']
            }
          }
        }
      }
    </script>

    <!-- Google Fonts & FontAwesome -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <style>
      .font-bebas { font-family: 'Bebas Neue', Impact, sans-serif; }
      .card-hover { transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
      .card-hover:hover { transform: translateY(-4px); }
    </style>
  </head>

  <body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col font-sans selection:bg-amber-500 selection:text-black">
    <header class="sticky top-0 z-50 bg-slate-950/90 backdrop-blur-md border-b border-slate-800">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
        <a href="<%= root_path %>" class="flex items-center space-x-3 group">
          <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-amber-500 to-red-600 flex items-center justify-center text-slate-950 text-xl font-black shadow-lg shadow-amber-500/20 group-hover:scale-105 transition-transform">
            <i class="fa-solid fa-star"></i>
          </div>
          <div>
            <span class="font-bebas text-2xl tracking-wider text-white group-hover:text-amber-400 transition-colors block leading-none">CHUCK NORRIS</span>
            <span class="text-[10px] uppercase tracking-widest text-amber-500 font-bold block mt-1">Daily Roundhouse & Blessings</span>
          </div>
        </a>

        <nav class="hidden md:flex items-center space-x-6 text-xs font-bold tracking-wide uppercase">
          <a href="#daily-joke" class="text-slate-300 hover:text-amber-400 transition-colors flex items-center gap-1.5">
            <i class="fa-solid fa-fire text-amber-500"></i> Joke of the Day
          </a>
          <a href="#meme-gallery" class="text-slate-300 hover:text-amber-400 transition-colors flex items-center gap-1.5">
            <i class="fa-solid fa-film text-amber-500"></i> Movie Memes
          </a>
          <a href="#instant-blessing" class="text-slate-300 hover:text-amber-400 transition-colors flex items-center gap-1.5">
            <i class="fa-solid fa-hand-fist text-amber-500"></i> Chuck's Blessing
          </a>
          <a href="#subscribe" class="bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 px-4 py-2 rounded-lg font-black uppercase tracking-wider shadow-lg shadow-amber-500/20 hover:shadow-amber-500/40 transition-all flex items-center gap-2">
            <i class="fa-solid fa-envelope"></i> Subscribe
          </a>
        </nav>

        <a href="#subscribe" class="md:hidden bg-amber-500 text-slate-950 px-3 py-1.5 rounded-lg font-black text-xs uppercase tracking-wider">
          Subscribe
        </a>
      </div>
    </header>

    <% if flash[:notice].present? %>
      <div class="bg-amber-500/10 border-b border-amber-500/30 px-4 py-3 text-center text-amber-300 text-sm font-medium flex items-center justify-center gap-2">
        <i class="fa-solid fa-circle-check text-amber-400 text-base"></i>
        <span><%= flash[:notice] %></span>
      </div>
    <% end %>

    <% if flash[:alert].present? %>
      <div class="bg-red-500/10 border-b border-red-500/30 px-4 py-3 text-center text-red-300 text-sm font-medium flex items-center justify-center gap-2">
        <i class="fa-solid fa-triangle-exclamation text-red-400 text-base"></i>
        <span><%= flash[:alert] %></span>
      </div>
    <% end %>

    <main class="flex-grow">
      <%= yield %>
    </main>

    <footer class="bg-slate-950 border-t border-slate-900 py-10 mt-16 text-center">
      <div class="max-w-7xl mx-auto px-4">
        <div class="w-10 h-10 mx-auto rounded-full bg-slate-900 border border-amber-500/40 flex items-center justify-center text-amber-400 mb-3">
          <i class="fa-solid fa-star"></i>
        </div>
        <h3 class="font-bebas text-xl tracking-wider text-slate-200">CHUCK NORRIS FACTS & BLESSINGS</h3>
        <p class="text-xs text-slate-500 max-w-md mx-auto mt-1">Chuck Norris doesn't sleep; he waits. All rights and physics belong to Chuck.</p>
        <div class="flex items-center justify-center gap-4 mt-4 text-xs text-slate-400">
          <a href="#daily-joke" class="hover:text-amber-400">Daily Joke</a>
          <span>•</span>
          <a href="#meme-gallery" class="hover:text-amber-400">Movie Memes</a>
          <span>•</span>
          <a href="#subscribe" class="hover:text-amber-400">Subscribe</a>
          <span>•</span>
          <a href="<%= preview_email_subscribers_path %>" target="_blank" class="hover:text-amber-400 flex items-center gap-1">
            <i class="fa-solid fa-eye"></i> Email Preview
          </a>
        </div>
      </div>
    </footer>
  </body>
</html>

